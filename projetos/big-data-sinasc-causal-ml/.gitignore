# Ambiente local
.venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Dados brutos e derivados grandes
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/raw/source_manifest.json
!data/interim/.gitkeep
!data/processed/.gitkeep

# Saídas reproduzíveis grandes
outputs/figures/*
outputs/tables/*
!outputs/figures/.gitkeep
!outputs/tables/.gitkeep

# Literatura local: PDFs e extrações integrais em TXT (direitos autorais)
docs/literature/pdfs/
docs/sp_capital_ato/artigos/*.pdf

# Artefatos temporários de notebook
*.nbconvert.ipynb
*.html

# Caches de ferramentas
.pytest_cache/

# Arquivo local: material retirado da estrutura ativa e backups (ver docs/manutencao/)
_arquivo_local/
